# Full reference: README.md#configuration

# Telegram API credentials (https://my.telegram.org -> API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Session string; takes precedence over the session file. Required for headless/Docker runs.
TELEGRAM_SESSION=
# Where the session is read from and saved to (default: ./.session)
# TELEGRAM_SESSION_FILE_PATH=

# PostgreSQL (TLS with certificate verification is required, see docs/status.md)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=telegram_archive
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password

# S3-compatible storage (AWS S3, Cloudflare R2, MinIO, Backblaze B2). Endpoint must include the protocol.
# The bucket must already exist.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio_admin_user
S3_SECRET_KEY=minio_admin_password
S3_BUCKET=telegram-archive-media

# Importer / server
IMPORT_CONCURRENCY=1
PORT=3000
# LOG_LEVEL=info

# Dashboard login
DASHBOARD_PASSWORD=your_secure_password_here

# Telegram SOCKS5 proxy (optional; port required when host is set)
# TELEGRAM_PROXY_HOST=
# TELEGRAM_PROXY_PORT=
# TELEGRAM_PROXY_USERNAME=
# TELEGRAM_PROXY_PASSWORD=
